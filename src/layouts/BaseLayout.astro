---
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import ContactChannelModal from '@/islands/ContactChannelModal';
import MobileStickyBar from '@/islands/MobileStickyBar';
import FloatingWhatsAppButton from '@/components/common/FloatingWhatsAppButton.astro';
import { buildPageMetadata, generateOpenGraphTags } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  canonicalUrl?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  noindex?: boolean;
  ogTitle?: string;
  twitterTitle?: string;
}

const {
  title,
  description,
  currentPath = '/',
  canonicalUrl,
  image,
  imageAlt,
  type,
  noindex,
  ogTitle,
  twitterTitle,
} = Astro.props;

const metadata = buildPageMetadata({
  title,
  description,
  currentPath,
  canonicalUrl,
  image,
  imageAlt,
  type,
  noindex,
  ogTitle,
  twitterTitle,
});

const ogTags = generateOpenGraphTags(metadata);
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonicalUrl} />
    <meta name="robots" content={metadata.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

    <!-- Open Graph Protocol & Twitter Cards -->
    {ogTags.map((tag) => (
      tag.property ? (
        <meta property={tag.property} content={tag.content} />
      ) : (
        <meta name={tag.name} content={tag.content} />
      )
    ))}

    <!-- Google Fonts: Montserrat (Titulares/Display) & Inter (Cuerpo/Datos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex flex-col min-h-screen bg-surface text-slate-900 font-body antialiased pb-20 md:pb-0">
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Componentes e islas interactivas de contacto y balanceo -->
    <ContactChannelModal client:load />
    <MobileStickyBar client:idle />
    <FloatingWhatsAppButton />

    <!-- Interceptor global para disparadores de contacto y cotización -->
    <script>
      import { getDirectWhatsAppUrl } from '@/lib/whatsapp';

      function setupContactTriggers() {
        // Disparadores de apertura del modal de selección y llamada/WhatsApp
        const modalTriggers = document.querySelectorAll('[data-open-contact-modal]');
        modalTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __modalBound?: boolean }).__modalBound) return;
          (trigger as HTMLElement & { __modalBound?: boolean }).__modalBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-contact-modal'));
          });
        });

        // Disparadores directos de WhatsApp
        const directTriggers = document.querySelectorAll(
          '[data-direct-whatsapp], a[href="#cotizar"]:not([data-open-contact-modal]), a[href="/#cotizar"]:not([data-open-contact-modal])'
        );
        directTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __directBound?: boolean }).__directBound) return;
          (trigger as HTMLElement & { __directBound?: boolean }).__directBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            const directUrl = getDirectWhatsAppUrl();
            window.open(directUrl, '_blank', 'noopener,noreferrer');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupContactTriggers);
      } else {
        setupContactTriggers();
      }
      document.addEventListener('astro:page-load', setupContactTriggers);
    </script>
  </body>
</html>
