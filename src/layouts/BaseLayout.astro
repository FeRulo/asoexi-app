---
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import ContactChannelModal from '@/islands/ContactChannelModal';
import LiveSearchModal from '@/islands/LiveSearchModal';
import QuoteDrawer from '@/islands/QuoteDrawer';
import MobileStickyBar from '@/islands/MobileStickyBar';
import FloatingWhatsAppButton from '@/components/common/FloatingWhatsAppButton.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import type { JsonLdInput } from '@/lib/seo';
import {
  sanitizeGa4MeasurementId,
  sanitizeGoogleAdsId,
  resolvePrimaryGtagScriptId,
} from '@/lib/analytics';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  canonicalUrl?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  noindex?: boolean;
  ogTitle?: string;
  twitterTitle?: string;
  jsonLd?: JsonLdInput | null;
  pageBrand?: string;
  pageSector?: string;
  pageBrandIsTractor?: boolean;
}

const {
  title,
  description,
  currentPath = '/',
  canonicalUrl,
  image,
  imageAlt,
  type,
  noindex,
  ogTitle,
  twitterTitle,
  jsonLd,
  pageBrand,
  pageSector,
  pageBrandIsTractor,
} = Astro.props;

const ga4MeasurementId = sanitizeGa4MeasurementId(
  import.meta.env.PUBLIC_GA4_MEASUREMENT_ID
);
const googleAdsId = sanitizeGoogleAdsId(
  import.meta.env.PUBLIC_GOOGLE_ADS_ID
);
const primaryGtagScriptId = resolvePrimaryGtagScriptId(
  ga4MeasurementId,
  googleAdsId
);
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      currentPath={currentPath}
      canonicalUrl={canonicalUrl}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      ogTitle={ogTitle}
      twitterTitle={twitterTitle}
      jsonLd={jsonLd}
    />

    <!-- Google Fonts: Montserrat (Titulares/Display) & Inter (Cuerpo/Datos) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Montserrat:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    {primaryGtagScriptId && (
      <>
        <script
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${primaryGtagScriptId}`}
        ></script>
        <script is:inline define:vars={{ ga4MeasurementId, googleAdsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          window.gtag = window.gtag || gtag;
          window.gtag('js', new Date());
          if (ga4MeasurementId) {
            window.gtag('config', ga4MeasurementId, { transport_type: 'beacon' });
          }
          if (googleAdsId) {
            window.gtag('config', googleAdsId, { transport_type: 'beacon' });
          }
        </script>
      </>
    )}
  </head>
  <body
    class="flex flex-col min-h-screen bg-surface text-slate-900 font-body antialiased pb-20 md:pb-0"
    data-page-brand={pageBrand || undefined}
    data-page-sector={pageSector || undefined}
    data-page-tractor={typeof pageBrandIsTractor === 'boolean' ? String(pageBrandIsTractor) : undefined}
  >
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Componentes e islas interactivas de contacto y balanceo -->
    <ContactChannelModal client:load />
    <LiveSearchModal client:idle />
    <QuoteDrawer client:idle />
    <MobileStickyBar client:idle />
    <FloatingWhatsAppButton />

    <!-- Interceptor global para disparadores de contacto y cotización -->
    <script>
      import { getDirectWhatsAppUrl } from '@/lib/whatsapp';
      import { handleDelegatedWhatsAppClick } from '@/lib/analytics';
      import { $cartStore } from '@/stores/cart';

      let cartBadgeUnsubscribe: (() => void) | null = null;

      function syncCartBadges(totalItems: number) {
        const badges = document.querySelectorAll('[data-cart-badge]');
        badges.forEach((badge) => {
          badge.textContent = String(totalItems);
          if (totalItems > 0) {
            badge.classList.remove('bg-slate-200', 'text-slate-700');
            badge.classList.add('bg-primary', 'text-white');
          } else {
            badge.classList.remove('bg-primary', 'text-white');
            badge.classList.add('bg-slate-200', 'text-slate-700');
          }
        });
      }

      function setupQuoteDrawerAndCartTriggers() {
        if (cartBadgeUnsubscribe) {
          cartBadgeUnsubscribe();
        }
        cartBadgeUnsubscribe = $cartStore.subscribe((state) => {
          syncCartBadges(state.totalItems);
        });

        // Disparadores de apertura del Cajón de Cotización (QuoteDrawer)
        const drawerTriggers = document.querySelectorAll('[data-open-quote-drawer]');
        drawerTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __drawerBound?: boolean }).__drawerBound) return;
          (trigger as HTMLElement & { __drawerBound?: boolean }).__drawerBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-quote-drawer'));
          });
        });

        // Botones "+ Agregar a requisición" en BrandCard y Silos de Marca
        const addButtons = document.querySelectorAll('[data-add-to-quote]');
        addButtons.forEach((btn) => {
          if ((btn as HTMLElement & { __addQuoteBound?: boolean }).__addQuoteBound) return;
          (btn as HTMLElement & { __addQuoteBound?: boolean }).__addQuoteBound = true;

          btn.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented) return;
            e.preventDefault();

            const el = btn as HTMLElement & {
              __feedbackTimer?: ReturnType<typeof setTimeout>;
            };
            const id = el.getAttribute('data-brand-id') || '';
            const name = el.getAttribute('data-brand-name') || '';
            if (!id || !name) return;

            const sector = el.getAttribute('data-brand-sector') || undefined;
            const url = el.getAttribute('data-brand-url') || undefined;
            const logo = el.getAttribute('data-brand-logo') || null;
            const isTractor = el.getAttribute('data-brand-tractor') === 'true';

            $cartStore.addItem({
              id,
              name,
              sector,
              url,
              logo,
              isTractor,
              type: 'brand',
            });

            const labelEl = el.querySelector('[data-add-label]');
            const storedOriginal = el.getAttribute('data-original-label');
            const originalText =
              storedOriginal || labelEl?.textContent || 'Agregar a requisición';
            if (!storedOriginal) {
              el.setAttribute('data-original-label', originalText);
            }
            if (labelEl) {
              labelEl.textContent = '¡Agregado!';
            }
            el.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');

            if (el.__feedbackTimer) {
              clearTimeout(el.__feedbackTimer);
            }
            el.__feedbackTimer = setTimeout(() => {
              if (labelEl) {
                labelEl.textContent = originalText;
              }
              el.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
              el.__feedbackTimer = undefined;
            }, 1400);
          });
        });
      }

      function setupContactTriggers() {
        // Disparadores de apertura del modal de cotización/WhatsApp
        const modalTriggers = document.querySelectorAll('[data-open-contact-modal]');
        modalTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __modalBound?: boolean }).__modalBound) return;
          (trigger as HTMLElement & { __modalBound?: boolean }).__modalBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-contact-modal'));
          });
        });

        // Disparadores de apertura del buscador en tiempo real
        const searchTriggers = document.querySelectorAll('[data-open-search-modal]');
        searchTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __searchBound?: boolean }).__searchBound) return;
          (trigger as HTMLElement & { __searchBound?: boolean }).__searchBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            window.dispatchEvent(new CustomEvent('open-search-modal'));
          });
        });

        // Disparadores directos de WhatsApp
        const directTriggers = document.querySelectorAll(
          '[data-direct-whatsapp], a[href="#cotizar"]:not([data-open-contact-modal]), a[href="/#cotizar"]:not([data-open-contact-modal])'
        );
        directTriggers.forEach((trigger) => {
          if ((trigger as HTMLElement & { __directBound?: boolean }).__directBound) return;
          (trigger as HTMLElement & { __directBound?: boolean }).__directBound = true;

          trigger.addEventListener('click', (evt) => {
            const e = evt as MouseEvent;
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            e.preventDefault();
            const directUrl = getDirectWhatsAppUrl();
            window.open(directUrl, '_blank', 'noopener,noreferrer');
          });
        });
      }

      let currentMascotObserver: IntersectionObserver | null = null;

      function setupSingletonMascotObserver() {
        if (typeof IntersectionObserver === 'undefined') return;

        if (currentMascotObserver) {
          currentMascotObserver.disconnect();
          currentMascotObserver = null;
        }

        const quoteBanner = document.querySelector('#cotizar') || document.querySelector('#lead-quote-section');
        const desktopWidget = document.getElementById('floating-whatsapp-widget');
        const mobileBar = document.getElementById('mobile-sticky-bar');

        if (!quoteBanner || (!desktopWidget && !mobileBar)) return;

        currentMascotObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const isVisible = entry.isIntersecting;
              if (desktopWidget) {
                if (isVisible) {
                  desktopWidget.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
                  desktopWidget.classList.remove('opacity-100', 'translate-y-0');
                } else {
                  desktopWidget.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
                  desktopWidget.classList.add('opacity-100', 'translate-y-0');
                }
              }
              if (mobileBar) {
                if (isVisible) {
                  mobileBar.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
                  mobileBar.classList.remove('translate-y-0', 'opacity-100');
                } else {
                  mobileBar.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
                  mobileBar.classList.add('translate-y-0', 'opacity-100');
                }
              }
            });
          },
          {
            threshold: 0.15,
          }
        );

        currentMascotObserver.observe(quoteBanner);
      }

      function setupWhatsAppAnalyticsDelegation() {
        if (window.__waAnalyticsBound) return;
        window.__waAnalyticsBound = true;

        document.addEventListener('click', (evt) => {
          try {
            handleDelegatedWhatsAppClick(evt.target);
          } catch {
            // Degradación silenciosa ante bloqueadores o entornos restringidos
          }
        });
      }

      function initLayoutInteractions() {
        setupContactTriggers();
        setupQuoteDrawerAndCartTriggers();
        setupSingletonMascotObserver();
        setupWhatsAppAnalyticsDelegation();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLayoutInteractions);
      } else {
        initLayoutInteractions();
      }
      document.addEventListener('astro:page-load', initLayoutInteractions);
    </script>
  </body>
</html>
