---
import { Image } from 'astro:assets';
import { CORPORATE_CLIENTS } from '@/lib/constants';

import casalimpiaImg from '@/assets/clients/casalimpia.png';
import unicentroImg from '@/assets/clients/unicentro.png';
import andinoImg from '@/assets/clients/andino.png';
import winnergroupImg from '@/assets/clients/winnergroup.png';
import multiplikaImg from '@/assets/clients/multiplika.png';

const clientLogos: Record<string, ImageMetadata> = {
  casalimpia: casalimpiaImg,
  unicentro: unicentroImg,
  andino: andinoImg,
  'winner-group': winnergroupImg,
  multiplika: multiplikaImg,
};

// Generamos dos mitades idénticas para garantizar un bucle continuo de 0% a -50% sin saltos en cualquier resolución
const halfItems = [...CORPORATE_CLIENTS, ...CORPORATE_CLIENTS];
const marqueeItems = [...halfItems, ...halfItems];
---

<!-- Franja de Social Proof: Carrusel Continuo Infinito con Logos Originales de Alta Resolución a Todo Color -->
<section id="clientes" class="py-14 sm:py-16 bg-surface border-b border-slate-200 overflow-hidden scroll-mt-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 sm:mb-10 text-center">
    <!-- Encabezado Institucional -->
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-secondary/5 text-secondary text-xs font-bold uppercase tracking-widest rounded-industrial border border-slate-200 mb-2.5">
      <span class="w-1.5 h-1.5 bg-primary"></span>
      <span>Trayectoria y Respaldo B2B Demostrado</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-display font-extrabold text-secondary tracking-tight">
      Empresas y Grandes Complejos que Confían en ASOEXI
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 font-body max-w-2xl mx-auto mt-2 leading-relaxed">
      Suministro mayorista continuo a centros comerciales emblemáticos, cadenas de hotelería y compañías líderes de servicios industriales en Colombia.
    </p>
  </div>

  <!-- Contenedor del Carrusel con Máscaras de Gradiente en los Extremos -->
  <div class="relative w-full overflow-hidden py-2" role="region" aria-label="Carrusel de clientes corporativos">
    <!-- Máscaras de desvanecimiento lateral para transición suave -->
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 sm:w-32 bg-gradient-to-r from-surface via-surface/85 to-transparent"></div>
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 sm:w-32 bg-gradient-to-l from-surface via-surface/85 to-transparent"></div>

    <!-- Pista Deslizante Infinita (se pausa al pasar el cursor o hacer foco) -->
    <div class="animate-marquee-infinite flex gap-4 sm:gap-6 py-2 px-2" role="list">
      {marqueeItems.map((client, index) => {
        const logoImage = clientLogos[client.id];
        const isAriaHidden = index >= CORPORATE_CLIENTS.length;

        return (
          <div
            role="listitem"
            aria-hidden={isAriaHidden ? 'true' : undefined}
            tabindex={isAriaHidden ? '-1' : '0'}
            title={`${client.name} — ${client.highlight}`}
            class="w-[270px] sm:w-[300px] shrink-0 bg-white p-5 rounded-industrial border border-slate-200/90 shadow-xs hover:shadow-md hover:border-primary/50 focus:border-primary/60 focus:ring-2 focus:ring-primary/20 focus:outline-none transition-all duration-300 flex flex-col justify-between group cursor-default select-none"
          >
            <!-- Contenedor del Logo Original a Todo Color en Alta Resolución -->
            <div class="h-18 sm:h-20 w-full flex items-center justify-center px-4 py-2 bg-slate-50/80 rounded-industrial border border-slate-100 group-hover:bg-white group-hover:border-slate-200 transition-colors">
              {logoImage ? (
                <Image
                  src={logoImage}
                  alt={client.logoAlt}
                  class="max-h-12 sm:max-h-14 w-auto max-w-[210px] object-contain transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <span class="font-display font-bold text-secondary text-sm">{client.name}</span>
              )}
            </div>

            <!-- Metadatos de la Empresa y Sector -->
            <div class="mt-3.5 pt-3 border-t border-slate-100">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display font-bold text-xs sm:text-sm text-secondary truncate">
                  {client.name}
                </span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0" title="Cliente activo verificado"></span>
              </div>
              <p class="text-[11px] text-slate-500 font-medium truncate mt-0.5" title={client.sector}>
                {client.sector}
              </p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
