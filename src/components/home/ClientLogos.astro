---
import { Image } from 'astro:assets';
import { CORPORATE_CLIENTS } from '@/lib/constants';

import andinoImg from '@/assets/clients/andino.png';
import casalimpiaImg from '@/assets/clients/casalimpia.png';
import unicentroImg from '@/assets/clients/unicentro.png';
import multiplikaImg from '@/assets/clients/multiplika.png';
import winnergroupImg from '@/assets/clients/winnergroup.png';

const clientLogos: Record<string, typeof andinoImg> = {
  casalimpia: casalimpiaImg,
  unicentro: unicentroImg,
  andino: andinoImg,
  'winner-group': winnergroupImg,
  multiplika: multiplikaImg,
};
---

<!-- Franja de Social Proof / Clientes Corporativos Normalizados -->
<section id="clientes" class="py-14 bg-surface border-b border-slate-200 overflow-x-hidden scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado sutil institucional -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-10">
      <span class="inline-block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1">
        Trayectoria y Confianza Demostrada
      </span>
      <h2 class="text-xl sm:text-2xl font-display font-bold text-secondary">
        Respaldando la Operación de Grandes Clientes Corporativos
      </h2>
      <p class="text-xs sm:text-sm text-slate-500 mt-1.5">
        Centros comerciales, operadores hoteleros y empresas de servicios confían en ASOEXI S.A.S. para su abastecimiento técnico.
      </p>
    </div>

    <!-- Grilla Armonizada de Logos (Escala de grises con hover a color y accesibilidad de teclado) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      {CORPORATE_CLIENTS.map((client, index) => {
        const logoImage = clientLogos[client.id];
        const isFifthItem = index === 4;

        return (
          <div
            tabindex="0"
            title={client.highlight}
            class={`bg-white p-4 sm:p-6 rounded-industrial border border-slate-100 hover:border-slate-300 focus-within:border-slate-300 focus-within:ring-2 focus-within:ring-primary/20 focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col items-center justify-center text-center group min-h-[112px] cursor-default ${
              isFifthItem ? 'col-span-2 sm:col-span-1 max-sm:max-w-xs max-sm:mx-auto max-sm:w-full' : ''
            }`}
          >
            <div class="w-full h-12 flex items-center justify-center">
              {logoImage ? (
                <Image
                  src={logoImage}
                  alt={client.logoAlt}
                  width={180}
                  height={48}
                  class="max-h-12 w-auto object-contain grayscale opacity-75 group-hover:grayscale-0 group-hover:opacity-100 group-focus-within:grayscale-0 group-focus-within:opacity-100 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
                  loading="lazy"
                />
              ) : (
                <span class="font-display font-bold text-secondary text-sm">{client.name}</span>
              )}
            </div>
            <span class="text-[11px] font-semibold text-slate-700 mt-2 truncate max-w-full">
              {client.name}
            </span>
            <span class="text-[10px] text-slate-400 block mt-0.5 truncate max-w-full">
              {client.sector}
            </span>
          </div>
        );
      })}
    </div>
  </div>
</section>
