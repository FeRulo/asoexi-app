---
import { VALUE_PILLARS } from '@/lib/constants';
---

<!-- Sección de Pilares de Confianza Institucional (Diferenciales B2B) -->
<section
  id="pilares"
  class="py-16 lg:py-20 bg-surface-subtle border-b border-slate-200 overflow-x-hidden scroll-mt-28"
  role="region"
  aria-label="5 pilares de confianza"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado de Sección -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest rounded-industrial border border-primary/20 mb-3">
        <span>Garantías Contractuales B2B</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-secondary tracking-tight">
        5 Pilares de Confianza y Continuidad Operativa
      </h2>
      <p class="text-sm sm:text-base text-slate-600 font-body mt-3 leading-relaxed">
        Compromisos reales y verificables concebidos para garantizar el suministro ininterrumpido en tus proyectos, contratos y operaciones corporativas.
      </p>
    </div>

    <!-- Grilla de los 5 Pilares de Confianza (Desktop 5 columnas, Móvil apilado, Tablet balanceado) -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 lg:gap-5"
      role="list"
    >
      {VALUE_PILLARS.map((pillar) => (
        <article
          class="bg-white border-t-4 border-t-primary border-x border-b border-slate-200 rounded-industrial p-5 sm:p-6 flex flex-col justify-between shadow-xs hover:shadow-md hover:border-slate-300 transition-all duration-200 group sm:max-lg:last:col-span-2 sm:max-lg:last:max-w-md sm:max-lg:last:mx-auto sm:max-lg:last:w-full"
          role="listitem"
        >
          <div>
            <!-- Badge / Indicador Superior -->
            {pillar.badge && (
              <span class="inline-block text-[11px] font-bold text-primary tracking-wider uppercase bg-primary/5 px-2.5 py-0.5 rounded-industrial border border-primary/15 mb-4">
                {pillar.badge}
              </span>
            )}

            <!-- Icono Técnico SVG gobernado por pillar.icon -->
            <div class="w-12 h-12 bg-surface-subtle border border-slate-200 group-hover:border-primary/40 group-hover:bg-primary/5 text-secondary group-hover:text-primary flex items-center justify-center rounded-industrial transition-colors mb-4">
              {pillar.icon === 'clock-bolt' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-9-9c2.52 0 4.85 1.03 6.54 2.71L21 8" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 3v5h-5" />
                </svg>
              )}
              {pillar.icon === 'credit-card' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                </svg>
              )}
              {pillar.icon === 'shield-check' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {pillar.icon === 'tag-check' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                </svg>
              )}
              {pillar.icon === 'truck-fast' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
              )}
              {/* Fallback default icon */}
              {!['clock-bolt', 'credit-card', 'shield-check', 'tag-check', 'truck-fast'].includes(pillar.icon) && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              )}
            </div>

            <!-- Titular del Pilar -->
            <h3 class="font-display font-bold text-base sm:text-lg text-secondary leading-snug group-hover:text-primary transition-colors">
              {pillar.title}
            </h3>

            <!-- Descripción Detallada -->
            <p class="text-xs sm:text-sm text-slate-600 font-body leading-relaxed mt-2.5">
              {pillar.description}
            </p>
          </div>

          <!-- Highlight / Resumen Destacado Inferior -->
          <div class="mt-4 pt-3 border-t border-slate-100">
            <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 bg-slate-100/80 px-2.5 py-1 rounded-industrial border border-slate-200">
              <span class="w-1.5 h-1.5 bg-primary rounded-none"></span>
              <span>{pillar.highlight}</span>
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
