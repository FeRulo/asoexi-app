---
import type { Brand } from '@/content.config';
import type { CollectionEntry } from 'astro:content';
import { generateBrandQuoteWhatsAppUrl } from '@/lib/whatsapp';

export interface Props {
  brand?: Brand | CollectionEntry<'brands'>;
  id?: string;
  name?: string;
  sector?: 'electrico' | 'ferretero-construccion' | 'hidraulico-pinturas';
  isTractor?: boolean;
  logo?: string | null;
  description?: string;
  applicationNotes?: string;
  pdfCatalogUrl?: string | null;
  class?: string;
}

const {
  brand,
  class: customClass = '',
} = Astro.props;

// Extract properties supporting both plain Brand object and Astro CollectionEntry<'brands'>
const rawBrand: Partial<Brand> =
  brand && typeof brand === 'object' && 'data' in brand
    ? { ...brand.data, id: (brand as { id?: string }).id ?? brand.data.id }
    : ((brand as Partial<Brand>) ?? {});

const data = {
  id: String(rawBrand.id ?? Astro.props.id ?? '').trim(),
  name: String(rawBrand.name ?? Astro.props.name ?? '').trim(),
  sector: (rawBrand.sector ?? Astro.props.sector ?? 'electrico') as 'electrico' | 'ferretero-construccion' | 'hidraulico-pinturas',
  isTractor: Boolean(rawBrand.isTractor ?? Astro.props.isTractor ?? false),
  logo: rawBrand.logo !== undefined ? rawBrand.logo : Astro.props.logo,
  description: String(rawBrand.description ?? Astro.props.description ?? '').trim(),
  applicationNotes: String(rawBrand.applicationNotes ?? Astro.props.applicationNotes ?? '').trim(),
  pdfCatalogUrl: rawBrand.pdfCatalogUrl !== undefined ? rawBrand.pdfCatalogUrl : Astro.props.pdfCatalogUrl,
};

const displayName = data.name || 'Marca';
const whatsappUrl = generateBrandQuoteWhatsAppUrl(data.name);

// Sector label & colors matching brand identity
const sectorConfig: Record<string, { label: string; badgeClass: string }> = {
  'electrico': {
    label: 'Eléctrico',
    badgeClass: 'text-red-700 bg-red-50 border-red-200/60',
  },
  'ferretero-construccion': {
    label: 'Ferretería & Construcción',
    badgeClass: 'text-amber-800 bg-amber-50 border-amber-200/60',
  },
  'hidraulico-pinturas': {
    label: 'Hidráulico & Pinturas',
    badgeClass: 'text-blue-700 bg-blue-50 border-blue-200/60',
  },
};

const currentSector = sectorConfig[data.sector] ?? {
  label: data.sector,
  badgeClass: 'text-slate-700 bg-slate-50 border-slate-200',
};

// Check if logo exists and is not an empty string
const hasValidLogo = typeof data.logo === 'string' && data.logo.trim().length > 0;

// Canonical silo link for brand (guarded to '#' if id is empty)
const brandSiloUrl = data.id ? `/distribuidor-${data.id}-colombia` : '#';
---

<article
  class={`bg-white border border-slate-200 hover:border-slate-300 rounded-industrial p-5 sm:p-6 flex flex-col justify-between shadow-xs hover:shadow-md transition-all duration-200 group h-full ${customClass}`}
  data-brand-id={data.id}
  data-sector={data.sector}
>
  <div>
    <!-- Header: Sector Pill & Tractor Badge -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class={`inline-block text-[11px] font-bold tracking-wider uppercase px-2.5 py-0.5 rounded-industrial border ${currentSector.badgeClass}`}>
        {currentSector.label}
      </span>
      {data.isTractor && (
        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded-industrial border border-slate-200">
          <svg class="w-3 h-3 text-amber-500 fill-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Marca Tractora
        </span>
      )}
    </div>

    <!-- Logo / Typographic Badge (EDGE-2) -->
    <div class="h-24 flex items-center justify-center p-2 mb-4 bg-slate-50/50 rounded-industrial border border-slate-100">
      {hasValidLogo ? (
        <img
          src={data.logo!}
          alt={`Logotipo oficial de ${displayName}`}
          width="160"
          height="48"
          loading="lazy"
          class="max-h-12 max-w-[160px] w-auto h-auto object-contain filter grayscale group-hover:grayscale-0 transition-all duration-300"
        />
      ) : (
        <div class="flex flex-col items-center justify-center text-center px-3 py-2 w-full h-full bg-slate-50 border border-slate-200 rounded-industrial">
          <span class="font-display font-extrabold text-base tracking-wider uppercase text-secondary">
            {displayName}
          </span>
          <span class="text-[10px] uppercase font-bold text-slate-500 tracking-widest mt-0.5">
            Distribución Mayorista
          </span>
        </div>
      )}
    </div>

    <!-- Brand Name and Description -->
    <h3 class="text-lg font-display font-bold text-secondary mb-2 group-hover:text-primary transition-colors">
      <a href={brandSiloUrl} class="hover:underline focus:outline-none focus:ring-2 focus:ring-primary/20 rounded-xs">
        {displayName}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-slate-600 font-body mb-3 leading-relaxed line-clamp-3">
      {data.description}
    </p>

    {data.applicationNotes.length > 0 && (
      <div class="text-[11px] text-slate-500 font-body bg-slate-50 p-2 rounded-industrial border border-slate-100 mb-4 line-clamp-2">
        <strong class="font-semibold text-slate-700">Aplicación:</strong> {data.applicationNotes}
      </div>
    )}
  </div>

  <!-- Footer Actions: Direct Corporate WhatsApp Quote CTA (min 48px height) -->
  <div class="pt-2 border-t border-slate-100 mt-auto">
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full min-h-[48px] px-4 py-3 inline-flex items-center justify-center gap-2 text-sm font-bold text-white bg-secondary hover:bg-secondary-hover active:bg-secondary-hover/90 rounded-industrial shadow-xs hover:shadow transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-secondary/50 group/btn"
      aria-label={`Cotizar ${displayName} por WhatsApp oficial`}
    >
      <span>Cotizar {displayName}</span>
      <svg class="w-4 h-4 text-emerald-400 group-hover/btn:translate-x-0.5 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.003-.467-1.579-.652-2.593-2.261-2.671-2.366-.078-.105-.644-.858-.644-1.635 0-.777.406-1.157.55-1.312.144-.156.314-.195.42-.195.105 0 .21.002.301.007.098.005.228-.037.357.273.131.314.446 1.09.485 1.17.039.078.065.17.013.274-.052.105-.078.17-.157.261-.078.092-.164.205-.235.276-.079.079-.161.165-.069.323.092.157.407.672.873 1.087.6.534 1.107.7 1.264.778.157.079.25.066.342-.039.092-.105.393-.458.498-.615.105-.157.21-.131.354-.078.144.052.916.432 1.073.511.157.079.262.118.301.184.039.066.039.38-.105.785z" />
      </svg>
    </a>
  </div>
</article>
