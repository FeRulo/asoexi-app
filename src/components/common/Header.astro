---
import {
  COMPANY_INFO,
  CONTACT_PHONES,
  COMMERCIAL_ADVISORS,
  NAVIGATION_LINKS,
} from '@/lib/constants';
import { generateWhatsAppUrl } from '@/lib/whatsapp';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const corporate = CONTACT_PHONES[0];
const advisorNames = COMMERCIAL_ADVISORS.map((a) => a.name).join(' y ');
const mainNavLinks = NAVIGATION_LINKS.filter((l) => !l.isCta);
const ctaLink = NAVIGATION_LINKS.find((l) => l.isCta) || {
  label: 'Cotizar Insumos',
  href: '/#cotizar',
};
---

<header class="w-full sticky top-0 z-50 shadow-sm bg-white">
  <!-- Top Bar Institucional (Oscura #1E2229) -->
  <div class="bg-secondary text-white text-xs sm:text-sm border-b border-slate-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-y-1 py-1 min-h-[48px]">
        <!-- Badge institucional / Trayectoria -->
        <div class="hidden lg:flex items-center gap-2 text-slate-300 font-medium">
          <span class="inline-block w-2 h-2 bg-primary animate-pulse"></span>
          <span>{COMPANY_INFO.name} — Más de {COMPANY_INFO.experienceYears} años abasteciendo a grandes compañías</span>
        </div>

        <!-- Enlaces directos de atención vía WhatsApp (Áreas táctiles ≥ 48px) -->
        <div class="w-full lg:w-auto flex items-center justify-between sm:justify-end gap-2 sm:gap-4 flex-wrap sm:flex-nowrap">
          <div class="flex items-center gap-1.5 text-xs text-slate-300">
            <span class="text-slate-400 font-medium hidden sm:inline">Equipo Comercial:</span>
            <span class="font-semibold text-white">{advisorNames}</span>
          </div>

          <span class="text-slate-600 hidden sm:inline select-none">|</span>

          <!-- Canal WhatsApp Corporativo -->
          <a
            href={generateWhatsAppUrl(corporate.e164)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`WhatsApp Corporativo: ${corporate.display}`}
            class="flex items-center gap-1.5 px-2.5 py-3 rounded-none hover:bg-white/10 hover:text-white text-slate-200 transition-colors min-h-[48px] text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <svg class="w-4 h-4 text-emerald-400 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
            </svg>
            <span class="hidden md:inline">WhatsApp:</span>
            <span class="font-mono">{corporate.display}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra Principal de Navegación (Blanca) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logotipo Oficial ASOEXI -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-primary p-1" aria-label="Página de inicio ASOEXI S.A.S.">
        <div class="w-12 h-12 flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
          <img
            src="/logo.svg"
            alt="Logo ASOEXI S.A.S."
            width="48"
            height="48"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-2xl tracking-tight text-secondary leading-none">
            ASOEXI<span class="text-primary">.</span>
          </span>
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 font-body">
            Distribuidor Mayorista
          </span>
        </div>
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Navegación principal">
        {mainNavLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-3 py-2 text-sm font-semibold transition-colors min-h-[48px] flex items-center ${
                isActive
                  ? 'text-primary border-b-2 border-primary bg-slate-50 font-bold'
                  : 'text-secondary hover:text-primary hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Botón CTA "Cotizar Insumos" & Menú Móvil Hamburger -->
      <div class="flex items-center gap-3">
        <!-- CTA Desktop / Tablet (Micro-radio 2px con Remate Angular a 45°) -->
        <a
          href={ctaLink.href}
          data-open-contact-modal
          class="group hidden sm:inline-flex items-stretch overflow-hidden rounded-industrial bg-primary hover:bg-primary-hover text-white shadow-sm transition-all duration-150 hover:translate-x-0.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
        >
          <span class="inline-flex items-center px-4 font-display font-bold text-xs tracking-wider uppercase">
            {ctaLink.label}
          </span>
          <span class="inline-flex items-center justify-center pl-2.5 pr-3 bg-black/15 group-hover:bg-black/25 text-white transition-colors icon-diagonal-45">
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <!-- Botón Menú Móvil -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
          class="md:hidden flex items-center justify-center w-12 h-12 border border-slate-200 rounded-industrial text-secondary hover:text-primary hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-primary min-h-[48px] min-w-[48px]"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
    <div class="px-4 pt-2 pb-4 space-y-1">
      {mainNavLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`mobile-menu-link flex items-center px-4 py-3 text-base font-semibold transition-colors min-h-[48px] border-b border-slate-100 last:border-b-0 rounded-industrial ${
              isActive
                ? 'text-primary border-b-2 border-primary bg-slate-50 font-bold'
                : 'text-secondary hover:text-primary hover:bg-slate-50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      <div class="pt-2">
        <a
          href={ctaLink.href}
          data-open-contact-modal
          class="group mobile-menu-link flex items-stretch overflow-hidden rounded-industrial w-full bg-primary hover:bg-primary-hover text-white shadow-sm transition-colors min-h-[48px]"
        >
          <span class="flex-1 flex items-center justify-center font-display font-bold text-sm tracking-wider uppercase py-3">
            {ctaLink.label}
          </span>
          <span class="flex items-center justify-center pl-3.5 pr-4 bg-black/15 icon-diagonal-45">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function closeMenu() {
    if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  }

  function openMenu() {
    if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
      toggleBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }
  }

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar menú al hacer clic en cualquier enlace interno del menú móvil
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Cerrar menú con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggleBtn.focus();
      }
    });
  }
</script>
