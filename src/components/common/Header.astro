---
import { COMPANY_INFO, CONTACT_PHONES, NAVIGATION_LINKS, type ContactPhone } from '@/lib/constants';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function getContact(id: string): ContactPhone {
  const found = CONTACT_PHONES.find((p) => p.id === id);
  if (found) return found;
  return {
    id,
    name: 'Atención Comercial',
    e164: '+573044013761',
    display: '+57 304 401 3761',
    role: 'Asesoría Institucional',
    hasWhatsApp: false,
  };
}

const geraldine = getContact('geraldine');
const sonia = getContact('sonia');
const corporate = getContact('corporate');
const mainNavLinks = NAVIGATION_LINKS.filter((l) => !l.isCta);
const ctaLink = NAVIGATION_LINKS.find((l) => l.isCta) || {
  label: 'Cotizar Insumos',
  href: '/#cotizar',
};
---

<header class="w-full sticky top-0 z-50 shadow-sm bg-white">
  <!-- Top Bar Telefónica Institucional (Oscura #1E2229) -->
  <div class="bg-secondary text-white text-xs sm:text-sm border-b border-slate-700/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-y-1 py-1 min-h-[48px]">
        <!-- Badge institucional / Trayectoria -->
        <div class="hidden lg:flex items-center gap-2 text-slate-300 font-medium">
          <span class="inline-block w-2 h-2 bg-primary animate-pulse"></span>
          <span>{COMPANY_INFO.name} — Más de {COMPANY_INFO.experienceYears} años abasteciendo a grandes compañías</span>
        </div>

        <!-- Enlaces directos de llamada (Áreas táctiles ≥ 48px) -->
        <div class="w-full lg:w-auto flex items-center justify-between sm:justify-end gap-1 sm:gap-2 flex-wrap sm:flex-nowrap">
          <span class="text-slate-400 text-xs hidden sm:inline mr-1 font-medium">Líneas de Atención:</span>

          <!-- Geraldine -->
          <a
            href={`tel:${geraldine.e164}`}
            aria-label={`Llamar a ${geraldine.name}: ${geraldine.display}`}
            class="flex items-center gap-1.5 px-2.5 py-3 rounded-none hover:bg-white/10 hover:text-white text-slate-200 transition-colors min-h-[48px] text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="hidden md:inline">{geraldine.name}:</span>
            <span class="font-mono">{geraldine.display}</span>
          </a>

          <span class="text-slate-600 hidden sm:inline select-none">|</span>

          <!-- Sonia -->
          <a
            href={`tel:${sonia.e164}`}
            aria-label={`Llamar a ${sonia.name}: ${sonia.display}`}
            class="flex items-center gap-1.5 px-2.5 py-3 rounded-none hover:bg-white/10 hover:text-white text-slate-200 transition-colors min-h-[48px] text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="hidden md:inline">{sonia.name}:</span>
            <span class="font-mono">{sonia.display}</span>
          </a>

          <span class="text-slate-600 hidden sm:inline select-none">|</span>

          <!-- Línea Corporativa -->
          <a
            href={`tel:${corporate.e164}`}
            aria-label={`Llamar a ${corporate.name}: ${corporate.display}`}
            class="flex items-center gap-1.5 px-2.5 py-3 rounded-none hover:bg-white/10 hover:text-white text-slate-200 transition-colors min-h-[48px] text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-primary"
          >
            <svg class="w-4 h-4 text-amber-industrial shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span class="hidden md:inline">Corporativo:</span>
            <span class="font-mono">{corporate.display}</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra Principal de Navegación (Blanca) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logotipo Oficial ASOEXI -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-primary p-1" aria-label="Página de inicio ASOEXI S.A.S.">
        <div class="w-12 h-12 flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
          <img
            src="/logo.svg"
            alt="Logo ASOEXI S.A.S."
            width="48"
            height="48"
            class="w-full h-full object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-2xl tracking-tight text-secondary leading-none">
            ASOEXI<span class="text-primary">.</span>
          </span>
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 font-body">
            Distribuidor Mayorista
          </span>
        </div>
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-2" aria-label="Navegación principal">
        {mainNavLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class={`px-3 py-2 text-sm font-semibold transition-colors min-h-[48px] flex items-center ${
                isActive
                  ? 'text-primary border-b-2 border-primary bg-slate-50 font-bold'
                  : 'text-secondary hover:text-primary hover:bg-slate-50'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Botón CTA "Cotizar Insumos" & Menú Móvil Hamburger -->
      <div class="flex items-center gap-3">
        <!-- CTA Desktop / Tablet (Micro-radio 2px con Remate Angular a 45°) -->
        <a
          href={ctaLink.href}
          data-open-contact-modal
          class="group hidden sm:inline-flex items-stretch overflow-hidden rounded-industrial bg-primary hover:bg-primary-hover text-white shadow-sm transition-all duration-150 hover:translate-x-0.5 min-h-[48px] focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
        >
          <span class="inline-flex items-center px-4 font-display font-bold text-xs tracking-wider uppercase">
            {ctaLink.label}
          </span>
          <span class="inline-flex items-center justify-center pl-2.5 pr-3 bg-black/15 group-hover:bg-black/25 text-white transition-colors icon-diagonal-45">
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>

        <!-- Botón Menú Móvil -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menú de navegación"
          class="md:hidden flex items-center justify-center w-12 h-12 border border-slate-200 rounded-industrial text-secondary hover:text-primary hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-primary min-h-[48px] min-w-[48px]"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú Desplegable Móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
    <div class="px-4 pt-2 pb-4 space-y-1">
      {mainNavLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-menu-link flex items-center px-4 py-3 text-base font-semibold text-secondary hover:text-primary hover:bg-slate-50 transition-colors min-h-[48px] border-b border-slate-100 last:border-b-0 rounded-industrial"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href={ctaLink.href}
          data-open-contact-modal
          class="group mobile-menu-link flex items-stretch overflow-hidden rounded-industrial w-full bg-primary hover:bg-primary-hover text-white shadow-sm transition-colors min-h-[48px]"
        >
          <span class="flex-1 flex items-center justify-center font-display font-bold text-sm tracking-wider uppercase py-3">
            {ctaLink.label}
          </span>
          <span class="flex items-center justify-center pl-3.5 pr-4 bg-black/15 icon-diagonal-45">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function closeMenu() {
    if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('hidden');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }
  }

  function openMenu() {
    if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
      toggleBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.classList.remove('hidden');
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }
  }

  if (toggleBtn && mobileMenu && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    // Cerrar menú al hacer clic en cualquier enlace interno del menú móvil
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Cerrar menú con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMenu();
        toggleBtn.focus();
      }
    });
  }
</script>
