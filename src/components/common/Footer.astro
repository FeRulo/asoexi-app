---
import {
  COMPANY_INFO,
  CONTACT_PHONES,
  OFFICIAL_EMAILS,
  BUSINESS_HOURS,
  LOGISTIC_NOTICE,
  NAVIGATION_LINKS,
} from '@/lib/constants';

const currentYear = new Date().getFullYear();
const mainNavLinks = NAVIGATION_LINKS.filter((l) => !l.isCta);
const ctaLink = NAVIGATION_LINKS.find((l) => l.isCta) || {
  label: 'Cotizar Insumos',
  href: '/#cotizar',
};
---

<footer class="bg-surface-dark text-slate-300 border-t border-slate-800">
  <!-- Aviso Logístico Destacado (Franja de advertencia/transparencia) -->
  <div class="bg-secondary/80 border-b border-slate-800 py-4 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto flex items-start sm:items-center gap-3">
      <div class="p-2 rounded-md bg-amber-industrial/10 text-amber-industrial shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-xs sm:text-sm text-slate-300 font-medium leading-relaxed">
        <strong class="text-white font-semibold">Política Operativa:</strong> {LOGISTIC_NOTICE}
      </p>
    </div>
  </div>

  <!-- Contenido Principal del Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Columna 1: Identidad Corporativa & NIT -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/logo-white.svg"
            alt="Logo ASOEXI S.A.S."
            width="40"
            height="40"
            class="w-10 h-10 object-contain"
            loading="lazy"
          />
          <span class="font-display font-bold text-2xl text-white tracking-tight">
            ASOEXI<span class="text-primary">.</span>
          </span>
        </div>
        <p class="text-xs text-slate-400 leading-relaxed font-body">
          Distribuidor mayorista y comercializador de insumos industriales, eléctricos, ferreteros e hidráulicos con más de {COMPANY_INFO.experienceYears} años abasteciendo obras, industrias y proyectos de infraestructura en Colombia.
        </p>
        <div class="pt-2 text-xs text-slate-400 space-y-1">
          <p><strong class="text-white">Razón Social:</strong> {COMPANY_INFO.legalName}</p>
          <p><strong class="text-white">NIT:</strong> {COMPANY_INFO.nit}</p>
          <p><strong class="text-white">Sede Administrativa:</strong> {COMPANY_INFO.address}, {COMPANY_INFO.city}</p>
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos, Sectores & CTA -->
      <div class="space-y-4">
        <h3 class="font-display font-semibold text-white text-base tracking-wide uppercase text-sm border-l-2 border-primary pl-2.5">
          Navegación & Sectores
        </h3>
        <ul class="space-y-1.5 text-sm font-medium">
          {mainNavLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-white transition-colors flex items-center gap-2 py-1.5 min-h-[44px]"
              >
                <span class="text-primary text-xs">▸</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
          <li>
            <a
              href="/#sector-electrico"
              class="hover:text-white transition-colors flex items-center gap-2 py-1.5 min-h-[44px]"
            >
              <span class="text-primary text-xs">▸</span>
              <span>Sector Eléctrico</span>
            </a>
          </li>
          <li>
            <a
              href="/#sector-ferretero"
              class="hover:text-white transition-colors flex items-center gap-2 py-1.5 min-h-[44px]"
            >
              <span class="text-primary text-xs">▸</span>
              <span>Sector Ferretero</span>
            </a>
          </li>
          <li>
            <a
              href="/#sector-hidraulico"
              class="hover:text-white transition-colors flex items-center gap-2 py-1.5 min-h-[44px]"
            >
              <span class="text-primary text-xs">▸</span>
              <span>Sector Hidráulico</span>
            </a>
          </li>
          <li class="pt-2">
            <a
              href={ctaLink.href}
              class="inline-flex items-center gap-2 px-3 py-2 rounded bg-primary/20 hover:bg-primary text-primary hover:text-white transition-colors text-xs font-bold min-h-[44px]"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>{ctaLink.label}</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Horarios de Atención & Correos -->
      <div class="space-y-4">
        <h3 class="font-display font-semibold text-white text-base tracking-wide uppercase text-sm border-l-2 border-primary pl-2.5">
          Horarios & Correos
        </h3>
        <div class="space-y-3 text-xs sm:text-sm">
          <div>
            <span class="block text-slate-400 font-medium">Horario Comercial:</span>
            <p class="text-white font-medium">{BUSINESS_HOURS.weekdays}</p>
            <p class="text-white font-medium">{BUSINESS_HOURS.saturdays}</p>
            <p class="text-slate-400 text-xs mt-1">{BUSINESS_HOURS.sundaysAndHolidays}</p>
          </div>

          <div class="pt-2">
            <span class="block text-slate-400 font-medium mb-1">Correos Oficiales:</span>
            <ul class="space-y-1.5">
              {OFFICIAL_EMAILS.map((email) => (
                <li>
                  <a
                    href={`mailto:${email.email}`}
                    class="text-slate-300 hover:text-primary transition-colors block text-xs font-mono break-all py-1 min-h-[36px] flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>{email.email}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Columna 4: Líneas de Contacto Directo -->
      <div class="space-y-4">
        <h3 class="font-display font-semibold text-white text-base tracking-wide uppercase text-sm border-l-2 border-primary pl-2.5">
          Contacto Directo
        </h3>
        <p class="text-xs text-slate-400">
          Atención telefónica comercial inmediata para cotizaciones y pedidos institucionales:
        </p>
        <div class="space-y-2">
          {CONTACT_PHONES.map((phone) => (
            <a
              href={`tel:${phone.e164}`}
              class="flex items-center justify-between p-3 rounded-md bg-secondary hover:bg-slate-700/60 border border-slate-700/60 text-white transition-all group min-h-[48px]"
            >
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-primary/20 text-primary flex items-center justify-center shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div>
                  <div class="text-xs font-semibold text-white">{phone.name}</div>
                  <div class="text-[11px] text-slate-400 font-mono">{phone.display}</div>
                </div>
              </div>
              <span class="text-xs text-primary font-bold opacity-0 group-hover:opacity-100 transition-opacity">
                Llamar
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Barra Inferior de Derechos y Créditos -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        © {currentYear} {COMPANY_INFO.name} — NIT: {COMPANY_INFO.nit}. Todos los derechos reservados.
      </p>
      <p class="text-slate-400">
        Comercialización y distribución técnica mayorista en Colombia.
      </p>
    </div>
  </div>
</footer>
