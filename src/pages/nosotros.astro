---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ClientLogos from '@/components/home/ClientLogos.astro';
import { COMPANY_INFO, CONTACT_PHONES, ABOUT_DATA } from '@/lib/constants';

const pageTitle = `Nosotros | ${COMPANY_INFO.name} - Distribuidor Mayorista B2B`;
const pageDescription =
  'Conoce la trayectoria de más de 7 años de ASOEXI S.A.S. Abastecimiento técnico B2B, protocolos de seguridad SG-SST y despacho directo a obra sin venta en mostrador.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  currentPath="/nosotros"
>
  <!-- Hero Institucional -->
  <section class="relative bg-secondary text-white py-16 sm:py-20 lg:py-24 border-b border-slate-800 overflow-hidden">
    <!-- Patrón geométrico de fondo con remate angular industrial -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute -right-24 -top-24 w-96 h-96 border-4 border-primary rounded-industrial transform rotate-45"></div>
      <div class="absolute right-1/4 -bottom-20 w-80 h-80 border-2 border-slate-500 rounded-industrial transform rotate-12"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <!-- Badge Industrial -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-primary/20 text-white text-xs font-bold uppercase tracking-wider rounded-industrial border border-primary/40 mb-6">
          <span class="w-2 h-2 bg-primary animate-pulse"></span>
          <span>{ABOUT_DATA.badge}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-display font-extrabold tracking-tight text-white leading-tight">
          {ABOUT_DATA.heroTitle}
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-body">
          {ABOUT_DATA.heroSubtitle}
        </p>

        <!-- Métricas Rápidas / Social Proof Stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-10 pt-8 border-t border-slate-800">
          {ABOUT_DATA.history.stats.map((stat) => (
            <div class="border-l-2 border-primary pl-4">
              <span class="block font-display font-black text-2xl sm:text-3xl text-white tracking-tight">
                {stat.value}
              </span>
              <span class="block text-xs text-slate-400 font-body mt-1 leading-snug">
                {stat.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Historia Corporativa -->
  <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-secondary/5 text-secondary text-xs font-bold uppercase tracking-wider rounded-industrial border border-slate-200">
            <span class="w-1.5 h-1.5 bg-primary"></span>
            <span>Identidad & Respaldo Legal</span>
          </div>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-secondary tracking-tight">
            {ABOUT_DATA.history.title}
          </h2>
          {ABOUT_DATA.history.paragraphs.map((p) => (
            <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-body">
              {p}
            </p>
          ))}
          <div class="pt-3">
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-industrial flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="text-xs font-bold uppercase text-slate-500 tracking-wider block">Razón Social</span>
                <span class="font-display font-bold text-secondary text-sm sm:text-base">{COMPANY_INFO.legalName}</span>
                <span class="text-xs text-slate-500 block font-body mt-0.5">Nombre comercial: <strong>{COMPANY_INFO.commercialName}</strong></span>
              </div>
              <div class="sm:text-right">
                <span class="text-xs font-bold uppercase text-slate-500 tracking-wider block">Identificación Tributaria</span>
                <span class="font-mono font-bold text-primary text-sm sm:text-base">NIT: {COMPANY_INFO.nit}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-surface-subtle p-6 sm:p-8 border border-slate-200 rounded-industrial shadow-xs">
          <h3 class="text-lg font-display font-bold text-secondary mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-primary"></span>
            Invariantes de Suministro B2B
          </h3>
          <ul class="space-y-4 text-xs sm:text-sm text-slate-700 font-body">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Facturación Electrónica DIAN:</strong> Emisión inmediata para deducción de costos y validación contable.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Fichas Técnicas & Certificados:</strong> Trazabilidad completa con fichas técnicas y certificados de calidad de fábrica.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Línea de Crédito a 45 Días:</strong> Condiciones de pago flexibles para empresas registradas y contratistas con RUT.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Atención Directa y Balanceada:</strong> Asesoría personalizada por ingenieros y asesoras comerciales dedicadas.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión & Visión -->
  <section class="py-16 sm:py-20 bg-surface-subtle border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-secondary">
          Misión y Visión Institucional
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-2">
          Los pilares estratégicos que orientan nuestro servicio hacia la excelencia operativa y la satisfacción técnica.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Misión -->
        <div class="bg-white p-8 border border-slate-200 rounded-industrial shadow-xs relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-primary"></div>
          <div>
            <div class="w-12 h-12 bg-red-50 text-primary flex items-center justify-center mb-6 border border-red-100 rounded-industrial">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-display font-bold text-secondary mb-3">
              {ABOUT_DATA.mission.title}
            </h3>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body">
              {ABOUT_DATA.mission.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-semibold text-primary">
            <span>Continuidad operativa garantizada</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>

        <!-- Visión -->
        <div class="bg-white p-8 border border-slate-200 rounded-industrial shadow-xs relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-secondary"></div>
          <div>
            <div class="w-12 h-12 bg-slate-100 text-secondary flex items-center justify-center mb-6 border border-slate-200 rounded-industrial">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h3 class="text-xl font-display font-bold text-secondary mb-3">
              {ABOUT_DATA.vision.title}
            </h3>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-body">
              {ABOUT_DATA.vision.description}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center gap-2 text-xs font-semibold text-secondary">
            <span>Liderazgo técnico y cobertura nacional</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Protocolos Operativos & Logísticos (Aviso Estricto de Despacho sin Mostrador) -->
  <section class="py-16 sm:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-50 text-amber-800 text-xs font-bold uppercase tracking-wider rounded-industrial border border-amber-200 mb-3">
          <span class="w-1.5 h-1.5 bg-amber-500"></span>
          <span>Política Logística Inviolable</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-secondary tracking-tight">
          {ABOUT_DATA.logistics.title}
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2 font-body">
          {ABOUT_DATA.logistics.description}
        </p>
      </div>

      <!-- Banner de Alerta Logística: Sede Administrativa & Sin Mostrador -->
      <div class="max-w-4xl mx-auto mb-12 p-6 sm:p-8 bg-amber-50 border-l-4 border-amber-500 rounded-industrial shadow-xs">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 bg-amber-100 text-amber-700 flex items-center justify-center shrink-0 rounded-industrial mt-0.5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="space-y-2">
            <h3 class="font-display font-bold text-base sm:text-lg text-amber-950">
              {ABOUT_DATA.logistics.administrativeNotice}: Despacho 100% a Domicilio en Obra y Empresa
            </h3>
            <p class="text-xs sm:text-sm text-amber-900 leading-relaxed font-body">
              Nuestras instalaciones centrales ubicadas en <strong>{ABOUT_DATA.logistics.headquartersAddress}</strong> operan estrictamente como sede de gestión administrativa, coordinación técnica y balanceo logístico.
            </p>
            <p class="text-xs sm:text-sm font-bold text-amber-950 bg-amber-100/70 p-2.5 rounded-industrial border border-amber-200">
              {ABOUT_DATA.logistics.noCounterNotice}. Todos los pedidos se despachan y entregan directamente en su punto de obra, bodega o empresa receptora.
            </p>
          </div>
        </div>
      </div>

      <!-- Cuadrícula de Características Logísticas -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {ABOUT_DATA.logistics.features.map((feature, idx) => (
          <div class="p-6 bg-surface-subtle border border-slate-200 rounded-industrial hover:border-slate-300 transition-colors">
            <div class="w-10 h-10 bg-secondary text-white flex items-center justify-center mb-4 rounded-industrial font-display font-bold text-sm">
              {String(idx + 1).padStart(2, '0')}
            </div>
            <h4 class="font-display font-bold text-base text-secondary mb-2">
              {feature.title}
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed font-body">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Protocolos de Seguridad y Salud en el Trabajo (SG-SST) -->
  <section class="py-16 sm:py-20 bg-surface-subtle border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-secondary/5 text-secondary text-xs font-bold uppercase tracking-wider rounded-industrial border border-slate-200 mb-3">
          <span class="w-1.5 h-1.5 bg-primary"></span>
          <span>Estándares de Seguridad Industrial</span>
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-display font-bold text-secondary tracking-tight">
          {ABOUT_DATA.safetyProtocols.title}
        </h2>
        <p class="text-slate-600 text-sm sm:text-base mt-2 font-body">
          {ABOUT_DATA.safetyProtocols.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {ABOUT_DATA.safetyProtocols.items.map((item) => (
          <div class="bg-white p-6 border border-slate-200 rounded-industrial shadow-xs hover:border-primary/50 transition-colors flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 bg-red-50 text-primary flex items-center justify-center mb-4 border border-red-100 rounded-industrial">
                {item.icon === 'shield-check' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {item.icon === 'document-search' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16l2.879-2.879m0 0a3 3 0 104.243-4.242 3 3 0 00-4.243 4.242zM21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {item.icon === 'document-text' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                )}
                {item.icon === 'truck-check' && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                  </svg>
                )}
                {!['shield-check', 'document-search', 'document-text', 'truck-check'].includes(item.icon) && (
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>
              <h3 class="font-display font-bold text-base text-secondary mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed font-body">
                {item.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-1.5 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
              <span>Protocolo Activo</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social Proof: Franja de Clientes Corporativos -->
  <ClientLogos />

  <!-- CTA de Cotización y Canales Oficiales de Contacto -->
  <section id="cotizar" class="py-16 sm:py-20 bg-secondary text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 text-slate-200 text-xs font-bold uppercase tracking-wider rounded-industrial border border-white/20 mb-2">
          <span class="w-2 h-2 bg-whatsapp"></span>
          <span>Atención Inmediata B2B</span>
        </div>
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight">
          ¿Listo para optimizar el suministro de tu empresa?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-body">
          Comunícate con nuestras asesoras comerciales oficiales para recibir cotizaciones con precios por volumen, asesoría técnica en sitio y apertura de línea de crédito comercial a 45 días.
        </p>

        <!-- Botones de Contacto Directo con Áreas Táctiles ≥ 48px -->
        <div class="flex flex-wrap justify-center items-center gap-3 pt-4">
          <a
            href="https://wa.me/573186397212?text=Hola%20ASOEXI%2C%20vi%20su%20p%C3%A1gina%20web%20y%20deseo%20solicitar%20una%20cotizaci%C3%B3n%20formal"
            target="_blank"
            rel="noopener noreferrer"
            data-open-contact-modal
            data-direct-whatsapp
            class="px-6 py-3.5 bg-primary hover:bg-primary-hover text-white text-xs sm:text-sm font-bold uppercase tracking-wider transition-colors flex items-center gap-2 min-h-[48px] rounded-industrial shadow-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 focus:ring-offset-secondary"
          >
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span>Cotizar vía WhatsApp</span>
          </a>

          {CONTACT_PHONES.map((phone) => (
            <a
              href={`tel:${phone.e164}`}
              class="px-4 py-3 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold tracking-wide uppercase transition-colors flex items-center gap-2 min-h-[48px] border border-white/15 rounded-industrial focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{phone.name}: {phone.display}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
