---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import ValuePillars from '@/components/home/ValuePillars.astro';
import ClientLogos from '@/components/home/ClientLogos.astro';
import { COMPANY_INFO, CONTACT_PHONES } from '@/lib/constants';
import { getDirectWhatsAppUrl } from '@/lib/whatsapp';
---

<BaseLayout
  title={`${COMPANY_INFO.name} | Distribuidor Mayorista de Insumos Industriales`}
  description="ASOEXI S.A.S. - Distribuidor mayorista de insumos industriales, eléctricos, ferreteros e hidráulicos en Bogotá y Colombia. NIT 900480460-8. Despacho 100% a domicilio."
  currentPath="/"
>
  <!-- Hero Institucional Modular -->
  <Hero />

  <!-- Pilares de Confianza Institucional (5 Garantías Contractuales B2B) -->
  <ValuePillars />

  <!-- Franja de Social Proof (Clientes Corporativos) -->
  <ClientLogos />

  <!-- Sectores Corporativos (Ancla #sectores) -->
  <section id="sectores" class="py-16 bg-surface-subtle border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-secondary">
          Nuestros 3 Sectores de Especialidad
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Abastecimiento técnico con fichas de producto, garantía directa de fábrica y despacho centralizado.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Eléctrico -->
        <div id="sector-electrico" class="p-6 bg-white border-t-4 border-t-sector-electrico border-x border-b border-slate-200 rounded-industrial shadow-sm hover:shadow-md transition-shadow scroll-mt-28">
          <div class="w-12 h-12 bg-red-50 text-sector-electrico flex items-center justify-center mb-4 border border-red-200 rounded-industrial">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-secondary">Sector Eléctrico</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Conductores, tableros de distribución, canalización, iluminación industrial y control Schneider, Siemens, Centelsa.
          </p>
        </div>

        <!-- Ferretero -->
        <div id="sector-ferretero" class="p-6 bg-white border-t-4 border-t-sector-ferretero border-x border-b border-slate-200 rounded-industrial shadow-sm hover:shadow-md transition-shadow scroll-mt-28">
          <div class="w-12 h-12 bg-amber-50 text-sector-ferretero flex items-center justify-center mb-4 border border-amber-200 rounded-industrial">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-secondary">Sector Ferretero & Construcción</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Herramientas eléctricas y manuales DeWalt, Stanley, discos de corte, abrasivos, fijaciones y tornillería de grado.
          </p>
        </div>

        <!-- Hidráulico -->
        <div id="sector-hidraulico" class="p-6 bg-white border-t-4 border-t-sector-hidraulico border-x border-b border-slate-200 rounded-industrial shadow-sm hover:shadow-md transition-shadow scroll-mt-28">
          <div class="w-12 h-12 bg-blue-50 text-sector-hidraulico flex items-center justify-center mb-4 border border-blue-200 rounded-industrial">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="font-display font-bold text-lg text-secondary">Sector Hidráulico & Pinturas</h3>
          <p class="text-xs text-slate-600 mt-2 leading-relaxed">
            Tubería sanitaria y de presión Pavco Wavin, válvulas, motobombas, recubrimientos industriales y solventes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Marcas y Cotización (Anclas #marcas y #cotizar) -->
  <section id="marcas" class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-display font-bold text-secondary">Catálogo Multimarca Autorizado</h2>
      <p class="text-xs text-slate-500 mt-2 max-w-xl mx-auto">
        Marcas 100% originales con respaldo directo de fábrica, certificados de conformidad y fichas técnicas oficiales.
      </p>

      <div id="cotizar" class="mt-10 p-6 sm:p-8 bg-secondary text-white max-w-4xl mx-auto border-t-4 border-primary rounded-industrial shadow-xl">
        <div class="flex flex-col md:flex-row items-center gap-6 sm:gap-8 text-left">
          <!-- Avatar animado de la Mascota Institucional (Asesor Técnico) -->
          <div class="relative shrink-0 mx-auto md:mx-0">
            <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full overflow-hidden border-4 border-white/25 shadow-2xl bg-white">
              <video
                autoplay
                loop
                muted
                playsinline
                disablepictureinpicture
                aria-hidden="true"
                class="w-full h-full object-cover pointer-events-none"
                src="/animated/recieve-call-float.mp4"
              ></video>
            </div>
            <!-- Badge "En Línea" posicionado sin recortes circulares -->
            <span class="absolute bottom-1 right-2 sm:bottom-2 sm:right-3 px-3 py-1 bg-emerald-500 text-[11px] font-bold text-white rounded-full border-2 border-white shadow-lg uppercase tracking-wider z-10 flex items-center gap-1.5 whitespace-nowrap">
              <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
              <span>En línea</span>
            </span>
          </div>

          <!-- Contenido y Llamado a la Acción Comercial -->
          <div class="flex-1 space-y-3 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 bg-amber-industrial/20 text-amber-industrial border border-amber-industrial/30 rounded-industrial text-xs font-semibold">
              <span class="w-2 h-2 bg-amber-industrial rounded-full animate-pulse"></span>
              Atención Inmediata • SLA &le; 5 min
            </div>
            <h3 class="font-display font-bold text-xl sm:text-2xl text-white">
              Solicita tu Cotización de Insumos Ferreteros e Industriales
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
              Atención directa por nuestro asesor técnico corporativo. Respuestas en menos de 5 minutos en horario hábil, listas de precios por volumen y despacho en 24–48h.
            </p>

            <div class="flex flex-wrap justify-center md:justify-start gap-3 pt-2">
              <a
                href={getDirectWhatsAppUrl()}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-3 bg-whatsapp hover:bg-whatsapp-hover text-white text-xs sm:text-sm font-bold tracking-wide uppercase transition-colors flex items-center gap-2 min-h-[48px] rounded-industrial shadow-md"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" />
                </svg>
                <span>Cotizar por WhatsApp</span>
              </a>

              {CONTACT_PHONES.map((phone) => (
                <a
                  href={`tel:${phone.e164}`}
                  class="px-4 py-3 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold tracking-wide uppercase transition-colors flex items-center gap-2 min-h-[48px] border border-white/15 rounded-industrial"
                >
                  <span class="w-2 h-2 bg-emerald-400 rounded-full"></span>
                  <span>{phone.name}: {phone.display}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
