---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import {
  SECTORS_META,
  getBrandSiloUrl,
  getBrandH1Title,
  buildBrandBreadcrumbs,
  hasValidBrandLogo,
  getBrandLogisticsPromise,
  hasValidPdfCatalog,
  normalizePdfCatalogUrl,
  getBrandProductFamilies,
  getBrandSourcingNotes,
} from '@/lib/brands';
import { generateBreadcrumbsSchema, resolveCanonicalUrl } from '@/lib/seo';
import {
  generateBrandQuoteWhatsAppUrl,
  generateBrandCatalogRequestWhatsAppUrl,
} from '@/lib/whatsapp';
import type { SectorId } from '@/content.config';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({
    params: { brand: (brand.data.id || brand.id).trim().toLowerCase() },
    props: { brand },
  }));
}

interface Props {
  brand: CollectionEntry<'brands'>;
}

const { brand } = Astro.props;
const { data } = brand;

const sectorMeta = SECTORS_META[data.sector as SectorId];
const sectorLabel = sectorMeta?.shortName || sectorMeta?.name || 'Sector Industrial';
const sectorSlug = sectorMeta?.slug || `sector-${data.sector}`;
const sectorHref = `/${sectorSlug}`;

// Canonical absolute URL
const siloRelativePath = getBrandSiloUrl(data.id);
const canonicalUrl = resolveCanonicalUrl(siloRelativePath);

// Breadcrumbs hierarchy: Inicio > Sector > [Marca] using shared domain helper
const breadcrumbItems = buildBrandBreadcrumbs(data.name, data.id, data.sector as SectorId, siloRelativePath);
const breadcrumbsSchema = generateBreadcrumbsSchema(breadcrumbItems);

// Standardized H1 formula from shared domain helper
const h1Title = getBrandH1Title(data.name);

// Page SEO Meta
const pageTitle = `${h1Title} | ASOEXI S.A.S.`;
const pageDescription = `Distribución mayorista autorizada de ${data.name} en Colombia. ${data.description} Facturación electrónica DIAN, crédito a 45 días y despacho 100% a domicilio en obra.`;

// WhatsApp quote CTA
const whatsappQuoteUrl = generateBrandQuoteWhatsAppUrl(data.name);

// EDGE-2 Logo Fallback verification using shared domain helper
const hasValidLogo = hasValidBrandLogo(data.logo);

// Differentiated Logistics Promise
const logisticsPromise = getBrandLogisticsPromise(data.isTractor);

// Conditional PDF Catalog vs WhatsApp Request (EDGE-2)
const hasPdfCatalog = hasValidPdfCatalog(data.pdfCatalogUrl);
const normalizedPdfCatalogUrl = normalizePdfCatalogUrl(data.pdfCatalogUrl);
const whatsappCatalogUrl = generateBrandCatalogRequestWhatsAppUrl(data.name);

// Product Families
const productFamilies = getBrandProductFamilies(data);

// Sourcing Notes (Story 3.3)
const brandSourcingNotes = getBrandSourcingNotes(data);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  currentPath={siloRelativePath}
  image={hasValidLogo ? data.logo! : undefined}
  imageAlt={`Logotipo oficial de ${data.name}`}
  jsonLd={breadcrumbsSchema}
>
  <div class="bg-surface py-6 sm:py-10 border-b border-slate-200">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <!-- Breadcrumbs navigation (WCAG 2.2 AA) -->
      <Breadcrumbs items={breadcrumbItems} class="mb-6" />

      <!-- Hero Header Section -->
      <section class="bg-white border border-slate-200 rounded-industrial p-6 sm:p-8 lg:p-10 shadow-xs mb-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Main Content Column -->
          <div class="lg:col-span-8 flex flex-col">
            <!-- Sector Pill & Tractor Badge -->
            <div class="flex flex-wrap items-center gap-2.5 mb-4">
              <a
                href={sectorHref}
                class={`inline-block text-[11px] font-bold tracking-wider uppercase px-3 py-1 rounded-industrial border transition-colors hover:opacity-90 ${
                  sectorMeta?.badgeClass ?? 'text-slate-700 bg-slate-50 border-slate-200'
                }`}
                title={`Ver catálogo de ${sectorLabel}`}
              >
                {sectorLabel}
              </a>

              {data.isTractor && (
                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded-industrial border border-slate-200">
                  <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  Marca Tractora Certificada
                </span>
              )}

              <span class="inline-flex items-center text-[11px] font-medium text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-industrial border border-emerald-200/60">
                Suministro Oficial B2B
              </span>
            </div>

            <!-- H1 Display Header -->
            <h1 class="font-display font-extrabold text-2xl sm:text-3xl lg:text-4xl text-secondary tracking-tight leading-tight mb-4">
              {h1Title}
            </h1>

            <!-- Brand Description -->
            <p class="font-body text-base sm:text-lg text-slate-700 leading-relaxed mb-6">
              {data.description}
            </p>

            <!-- Institutional Trust Badges (Facturación DIAN / Crédito 45 días / Despacho a Obra) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
              <div class="flex items-center gap-2.5 p-3 rounded-industrial bg-slate-50 border border-slate-100">
                <div class="w-8 h-8 rounded-industrial bg-red-100 text-primary flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-bold text-slate-900">Facturación DIAN</span>
                  <span class="block text-[11px] text-slate-500">100% electrónica formal</span>
                </div>
              </div>

              <div class="flex items-center gap-2.5 p-3 rounded-industrial bg-slate-50 border border-slate-100">
                <div class="w-8 h-8 rounded-industrial bg-amber-100 text-amber-800 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-bold text-slate-900">Crédito a 45 Días</span>
                  <span class="block text-[11px] text-slate-500">Para empresas con RUT</span>
                </div>
              </div>

              <div class="flex items-center gap-2.5 p-3 rounded-industrial bg-slate-50 border border-slate-100">
                <div class="w-8 h-8 rounded-industrial bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                  </svg>
                </div>
                <div>
                  <span class="block text-xs font-bold text-slate-900">Despacho en Obra</span>
                  <span class="block text-[11px] text-slate-500">100% entrega a domicilio</span>
                </div>
              </div>
            </div>

            <!-- Call to Action Buttons (WCAG 2.2 AA ≥ 48px height) -->
            <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 mb-3">
              <!-- Primary: Cotización formal por WhatsApp -->
              <a
                href={whatsappQuoteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[52px] px-6 py-3.5 inline-flex items-center justify-center gap-3 text-base font-bold text-white bg-secondary hover:bg-secondary-hover active:bg-secondary-hover/90 rounded-industrial shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-secondary/50 group/cta"
                aria-label={`Cotizar portafolio de ${data.name} por WhatsApp oficial de ASOEXI`}
              >
                <span>Cotizar portafolio de {data.name} por WhatsApp</span>
                <svg class="w-5 h-5 text-emerald-400 group-hover/cta:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.003-.467-1.579-.652-2.593-2.261-2.671-2.366-.078-.105-.644-.858-.644-1.635 0-.777.406-1.157.55-1.312.144-.156.314-.195.42-.195.105 0 .21.002.301.007.098.005.228-.037.357.273.131.314.446 1.09.485 1.17.039.078.065.17.013.274-.052.105-.078.17-.157.261-.078.092-.164.205-.235.276-.079.079-.161.165-.069.323.092.157.407.672.873 1.087.6.534 1.107.7 1.264.778.157.079.25.066.342-.039.092-.105.393-.458.498-.615.105-.157.21-.131.354-.078.144.052.916.432 1.073.511.157.079.262.118.301.184.039.066.039.38-.105.785z" />
                </svg>
              </a>

              <!-- Requisition Add Button (Story 4.2) -->
              <button
                type="button"
                data-add-to-quote
                data-brand-id={data.id}
                data-brand-name={data.name}
                data-brand-sector={data.sector}
                data-brand-url={siloRelativePath}
                data-brand-logo={hasValidLogo ? data.logo! : ''}
                data-brand-tractor={data.isTractor ? 'true' : 'false'}
                aria-label={`Agregar ${data.name} a la lista de requisición multimarca`}
                class="min-h-[48px] px-5 py-3 inline-flex items-center justify-center gap-2 text-sm font-bold text-primary bg-red-50/70 hover:bg-primary hover:text-white border border-primary/30 rounded-industrial shadow-2xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary cursor-pointer"
              >
                <span class="font-bold text-base" aria-hidden="true">+</span>
                <span data-add-label>Agregar a requisición</span>
              </button>

              <!-- Secondary: Descarga Condicional de Catálogo PDF vs Solicitud WhatsApp (EDGE-2) -->
              {hasPdfCatalog && normalizedPdfCatalogUrl ? (
                <a
                  href={normalizedPdfCatalogUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  type="application/pdf"
                  class="min-h-[48px] px-5 py-3 inline-flex items-center justify-center gap-2.5 text-sm font-bold text-slate-800 bg-white hover:bg-slate-50 border border-slate-300 rounded-industrial shadow-2xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-secondary/30"
                  aria-label={`Descargar Ficha Técnica / Catálogo PDF de ${data.name} (se abre en pestaña nueva)`}
                >
                  <svg class="w-5 h-5 text-red-600 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                  </svg>
                  <span>Descargar Ficha Técnica / Catálogo PDF</span>
                </a>
              ) : (
                <a
                  href={whatsappCatalogUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-h-[48px] px-5 py-3 inline-flex items-center justify-center gap-2.5 text-sm font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 rounded-industrial shadow-2xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/30"
                  aria-label={`Solicitar catálogo técnico de fábrica para ${data.name} por WhatsApp`}
                >
                  <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.003-.467-1.579-.652-2.593-2.261-2.671-2.366-.078-.105-.644-.858-.644-1.635 0-.777.406-1.157.55-1.312.144-.156.314-.195.42-.195.105 0 .21.002.301.007.098.005.228-.037.357.273.131.314.446 1.09.485 1.17.039.078.065.17.013.274-.052.105-.078.17-.157.261-.078.092-.164.205-.235.276-.079.079-.161.165-.069.323.092.157.407.672.873 1.087.6.534 1.107.7 1.264.778.157.079.25.066.342-.039.092-.105.393-.458.498-.615.105-.157.21-.131.354-.078.144.052.916.432 1.073.511.157.079.262.118.301.184.039.066.039.38-.105.785z" />
                  </svg>
                  <span>Solicitar catálogo técnico de fábrica por WhatsApp</span>
                </a>
              )}
            </div>

            <!-- Response SLA Indicator -->
            <div class="flex items-center gap-1.5 text-xs font-semibold text-slate-500">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Promesa SLA ≤ 5 min en horario hábil</span>
            </div>
          </div>

          <!-- Brand Logo / Typographic Badge Column (EDGE-2) -->
          <div class="lg:col-span-4 w-full">
            <div class="bg-slate-50 border border-slate-200 rounded-industrial p-6 flex flex-col items-center justify-center text-center">
              <span class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">
                Identidad de Marca
              </span>

              <div class="w-full h-32 flex items-center justify-center p-4 bg-white rounded-industrial border border-slate-200 mb-4 shadow-2xs">
                {hasValidLogo ? (
                  <img
                    src={data.logo!}
                    alt={`Logotipo oficial de ${data.name}`}
                    width="200"
                    height="64"
                    loading="eager"
                    class="max-h-16 max-w-[200px] w-auto h-auto object-contain transition-all duration-300"
                  />
                ) : (
                  <div class="flex flex-col items-center justify-center text-center px-4 py-3 w-full h-full bg-slate-50 border border-slate-200 rounded-industrial">
                    <span class="font-display font-extrabold text-xl sm:text-2xl tracking-wider uppercase text-secondary">
                      {data.name}
                    </span>
                    <span class="text-[10px] uppercase font-bold text-slate-500 tracking-widest mt-1">
                      Distribución Mayorista
                    </span>
                  </div>
                )}
              </div>

              <div class="w-full text-left bg-white p-3.5 rounded-industrial border border-slate-200 text-xs text-slate-600 space-y-1.5">
                <div class="flex justify-between items-center py-0.5 border-b border-slate-100">
                  <span class="text-slate-500">Distribuidor:</span>
                  <strong class="text-slate-800">ASOEXI S.A.S.</strong>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-slate-100">
                  <span class="text-slate-500">NIT:</span>
                  <strong class="text-slate-800">900480460-8</strong>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-slate-100">
                  <span class="text-slate-500">Línea Oficial:</span>
                  <strong class="text-slate-800">+57 301 419 1344</strong>
                </div>
                <div class="flex justify-between items-center py-0.5">
                  <span class="text-slate-500">Atención:</span>
                  <strong class="text-slate-800">Geraldine y Sonia</strong>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- Promesa Logística Diferenciada (FR-5, FR-6) -->
      <section class={`p-6 sm:p-8 rounded-industrial border mb-8 ${logisticsPromise.containerClass}`}>
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2.5 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`inline-flex items-center gap-1.5 text-xs font-bold px-2.5 py-1 rounded-industrial border ${logisticsPromise.badgeClass}`}>
                {logisticsPromise.urgentDelivery ? (
                  <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                ) : (
                  <svg class="w-4 h-4 text-slate-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {logisticsPromise.badgeLabel}
              </span>
              <span class="text-xs font-bold uppercase tracking-wider text-slate-600">
                {logisticsPromise.headline}
              </span>
            </div>

            <h2 class="font-display font-bold text-xl sm:text-2xl text-secondary tracking-tight">
              {logisticsPromise.promise}
            </h2>

            <p class="font-body text-sm sm:text-base text-slate-600 leading-relaxed">
              {logisticsPromise.description}
            </p>
          </div>

          <!-- Credenciales Logísticas y Comerciales -->
          <div class="shrink-0 w-full md:w-auto bg-slate-50 border border-slate-200/80 rounded-industrial p-4 space-y-2 text-xs">
            <div class="flex items-center gap-2 text-slate-800 font-semibold">
              <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{logisticsPromise.creditDaysNotice}</span>
            </div>
            <div class="flex items-center gap-2 text-slate-800 font-semibold">
              <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{logisticsPromise.dianNotice}</span>
            </div>
            <div class="flex items-center gap-2 text-slate-800 font-semibold">
              <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Despacho 100% a domicilio en obra o planta</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Vitrina de Portafolio y Familias de Productos (Story 3.2) -->
      <section class="bg-white border border-slate-200 rounded-industrial p-6 sm:p-8 shadow-xs mb-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-industrial bg-secondary text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-xl sm:text-2xl text-secondary">
                Vitrina de Portafolio y Familias de Productos {data.name}
              </h2>
              <p class="text-xs sm:text-sm text-slate-500">
                Líneas principales suministradas con disponibilidad inmediata o bajo pedido de fábrica
              </p>
            </div>
          </div>

          <!-- Quick Action Button for technical datasheet / catalog -->
          <div>
            {hasPdfCatalog && normalizedPdfCatalogUrl ? (
              <a
                href={normalizedPdfCatalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                type="application/pdf"
                class="min-h-[48px] px-4 py-2.5 inline-flex items-center gap-2 text-xs font-bold text-slate-800 bg-slate-50 hover:bg-slate-100 border border-slate-300 rounded-industrial transition-colors"
                aria-label={`Descargar catálogo técnico oficial en PDF de ${data.name} (abre en pestaña nueva)`}
              >
                <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
                </svg>
                <span>Descargar Ficha Técnica / Catálogo PDF</span>
              </a>
            ) : (
              <a
                href={whatsappCatalogUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[48px] px-4 py-2.5 inline-flex items-center gap-2 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 rounded-industrial transition-colors"
                aria-label={`Solicitar catálogo técnico de fábrica para ${data.name} por WhatsApp`}
              >
                <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.074-2.003-.467-1.579-.652-2.593-2.261-2.671-2.366-.078-.105-.644-.858-.644-1.635 0-.777.406-1.157.55-1.312.144-.156.314-.195.42-.195.105 0 .21.002.301.007.098.005.228-.037.357.273.131.314.446 1.09.485 1.17.039.078.065.17.013.274-.052.105-.078.17-.157.261-.078.092-.164.205-.235.276-.079.079-.161.165-.069.323.092.157.407.672.873 1.087.6.534 1.107.7 1.264.778.157.079.25.066.342-.039.092-.105.393-.458.498-.615.105-.157.21-.131.354-.078.144.052.916.432 1.073.511.157.079.262.118.301.184.039.066.039.38-.105.785z" />
                </svg>
                <span>Solicitar catálogo técnico de fábrica por WhatsApp</span>
              </a>
            )}
          </div>
        </div>

        <!-- Grilla de Familias de Productos -->
        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {productFamilies.map((family, idx) => (
            <li class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200 rounded-industrial hover:border-slate-300 hover:bg-slate-50/80 transition-all shadow-2xs">
              <div class="w-8 h-8 rounded-industrial bg-white border border-slate-200 text-slate-700 flex items-center justify-center shrink-0 font-display font-bold text-xs" aria-hidden="true">
                {idx + 1}
              </div>
              <div>
                <h3 class="font-display font-bold text-sm text-secondary mb-1">
                  {family}
                </h3>
                <span class="inline-block text-[11px] text-slate-500 font-medium">
                  Disponibilidad B2B para Obra e Industria
                </span>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- Technical Application Section -->
      {data.applicationNotes && data.applicationNotes.trim().length > 0 && (
        <section class="bg-white border border-slate-200 rounded-industrial p-6 sm:p-8 shadow-xs mb-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-industrial bg-secondary text-white flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-xl sm:text-2xl text-secondary">
                Notas Técnicas de Aplicación en Obra e Industria
              </h2>
              <p class="text-xs text-slate-500">
                Criterios de ingeniería y especificaciones para mantenimiento y proyectos
              </p>
            </div>
          </div>

          <div class="p-4 sm:p-5 bg-slate-50 border border-slate-200 rounded-industrial">
            <p class="font-body text-slate-700 text-sm sm:text-base leading-relaxed">
              {data.applicationNotes}
            </p>
          </div>
        </section>
      )}

      <!-- Garantía de Abastecimiento Integral y Pedidos a Fábrica (Story 3.3) -->
      <section class="bg-white border border-slate-200 rounded-industrial p-6 sm:p-8 shadow-xs mb-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 rounded-industrial bg-secondary text-white flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <h2 class="font-display font-bold text-xl sm:text-2xl text-secondary">
              Garantía de Abastecimiento Integral y Pedidos a Fábrica
            </h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Suministro mayorista directo de fábrica para referencias de catálogo o requerimientos especiales de obra
            </p>
          </div>
        </div>

        <div class="p-5 bg-slate-50 border border-slate-200 rounded-industrial mb-6">
          <p class="font-body text-slate-700 text-sm sm:text-base leading-relaxed">
            {brandSourcingNotes}
          </p>
        </div>

        <!-- Microcopy institucional de solvencia logística -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="flex items-center gap-2 p-3 bg-white rounded-industrial border border-slate-200 text-slate-700">
            <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="font-medium">Canal mayorista directo de fabricante</span>
          </div>
          <div class="flex items-center gap-2 p-3 bg-white rounded-industrial border border-slate-200 text-slate-700">
            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium">Consolidación de pedidos en obra</span>
          </div>
          <div class="flex items-center gap-2 p-3 bg-white rounded-industrial border border-slate-200 text-slate-700">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="font-medium">SLA de cotización formal ≤ 5 min</span>
          </div>
        </div>
      </section>

      <!-- Breadcrumb Context & Sector Navigation Footer -->
      <section class="flex flex-col sm:flex-row items-center justify-between gap-4 p-5 bg-slate-100 border border-slate-200 rounded-industrial text-sm">
        <div class="text-slate-600 text-center sm:text-left">
          <span>¿Busca consolidar pedidos multimarca con {data.name}?</span>
          <span class="block sm:inline font-semibold text-slate-900 sm:ml-1">
            Consulte el catálogo completo del {sectorLabel}.
          </span>
        </div>
        <a
          href={sectorHref}
          class="inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-slate-800 bg-white hover:bg-slate-50 border border-slate-300 rounded-industrial shadow-2xs transition-colors shrink-0"
        >
          <span>Ver marcas de {sectorLabel}</span>
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </section>

    </div>
  </div>
</BaseLayout>
